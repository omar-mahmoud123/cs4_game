	@Override
	public void onLand(Monster landingMonster, Monster opponentMonster) {
	    super.onLand(landingMonster, opponentMonster);
	    if(!this.isActivated()) {
	        
	        if(landingMonster.getRole() != this.getRole()){
	            // Only activate if they aren't shielded AND energy is actually being lost
	            if(!landingMonster.isShielded() && this.getEnergy() > 0) {
	                this.setActivated(true);
	            }
	            modifyCanisterEnergy(landingMonster, -this.getEnergy());
	            
	        } else {
	            // Only activate if energy is actually being gained
	            if(this.getEnergy() > 0) {
	                this.setActivated(true);
	            }
	            modifyCanisterEnergy(landingMonster, this.getEnergy());
	        }
	        
	    }
	}

	@Override
	public void modifyCanisterEnergy(Monster monster, int canisterValue) {
	    // Check if the landing monster has a shield that will block a negative penalty
	    boolean teamProtected = monster.isShielded() && canisterValue < 0;
	    
	    // Apply to the landing monster (this will safely consume their shield if it's negative)
	    monster.alterEnergy(canisterValue);
	    
	    // If the team is NOT protected by the landing monster's shield, apply the change to everyone else
	    if (!teamProtected) {
	        ArrayList<Monster> stationedMonsters = Board.getStationedMonsters();
	        
	        for(int i = 0; i < stationedMonsters.size(); i++) {
	            Monster current = stationedMonsters.get(i);
	            
	            if(current.getRole() == monster.getRole()) {
	                current.alterEnergy(canisterValue);
	            }
	        }
	    }
	}
}
